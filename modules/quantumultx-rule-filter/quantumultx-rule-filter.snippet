[rewrite_local]
^https:\/\/magic\.rule\/[^\/?]+(?:\?|$) url script-echo-response https://magicrule.pages.dev/modules/quantumultx-rule-filter/quantumultx-rule-filter.js

[mitm]
hostname = %APPEND% magic.rule
