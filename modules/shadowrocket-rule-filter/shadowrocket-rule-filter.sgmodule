[Script]
Rule Filter = type=http-request,pattern=^https:\/\/magic\.rule\/[^\/?]+(?:\?|$),script-path=https://magicrule.pages.dev/modules/shadowrocket-rule-filter/shadowrocket-rule-filter.js,timeout=300,engine=webview

